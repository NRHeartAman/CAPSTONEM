SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
# Add your machine's LAN IP here (e.g. from `ipconfig`) so other devices on
# the same WiFi can reach the server - see serve on LAN instructions in README.
ALLOWED_HOSTS=127.0.0.1,localhost
# The address used to build every link sent in an email (activation,
# password reset, request alerts) - must be reachable by whoever clicks
# it. Use your LAN IP if Staff/Owner use different devices.
SITE_BASE_URL=http://127.0.0.1:8000

DB_NAME=cravecast_db
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

EMAIL_HOST_USER=your-gmail-address@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-gmail-app-password

# Default OpenWeatherMap key, used only when the Owner hasn't set one in
# Settings. Never exposed to the browser - the Forecast page calls a
# backend proxy, not OpenWeatherMap directly.
OPENWEATHER_API_KEY=your-openweathermap-key
